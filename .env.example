# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# Never commit the real .env file — it is already excluded via .gitignore.

# --- PostgreSQL ---
POSTGRES_USER=estateflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=estateflow
# Host port Postgres is published on. Change if 5432 is already in use on your machine.
POSTGRES_PORT=5432

# --- Redis ---
# Host port Redis is published on. Change if 6379 is already in use on your machine.
REDIS_PORT=6379

# --- Backend (Express API) ---
# Host port the backend API is published on. Change if 5000 is already in use on your machine
# (on macOS, AirPlay Receiver commonly occupies port 5000 — disable it or change this value).
BACKEND_PORT=5000

# --- Frontend (Nginx) ---
# Host port the frontend is published on. Change if 8080 is already in use on your machine.
FRONTEND_PORT=8080
